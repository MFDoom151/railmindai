# Скопируйте в .env и задайте значения. Секреты в репозиторий не коммитятся.
RAILTWIN_DEV=0                       # 0 — отключить демо-учётки (обязательно для прода)
RAILTWIN_SECRET=change-me-long-random-string
RAILTWIN_ADMIN_USER=admin
RAILTWIN_ADMIN_PASSWORD=change-me
RAILTWIN_DISPATCHER_USER=dispatcher
RAILTWIN_DISPATCHER_PASSWORD=change-me
# необязательно:
# RAILTWIN_CONFIG=/app/backend/config/default.yaml
# RAILTWIN_CONFIG_OVERRIDE=/app/backend/data/config.override.yaml
# RAILTWIN_DB_PATH=/app/backend/data/railtwin.db
RAILTWIN_OPEN_DEMO=0                 # 1 — анонимный посетитель работает как диспетчер (публичный демо-стенд для жюри)
# RAILTWIN__planner__workers=2       # любой параметр конфигурации: RAILTWIN__<раздел>__<ключ>
